# OpenAI
OPENAI_API_KEY="YOUR_KEY"
LANGUAGE_MODEL="gpt-4o-mini"                 # any OpenAI chat model, e.g. gpt-4.1
EMBEDDINGS_MODEL="text-embedding-3-small"    # must match between ingest.py and chat.py

# Local Chroma vector DB
CHROMA_PATH="./chroma_db"

# Files skipped during indexing (comma-separated file names)
FILES_TO_IGNORE="package-lock.json,yarn.lock,pnpm-lock.yaml,LICENSE,.gitattributes,.gitignore"
